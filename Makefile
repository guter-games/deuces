.PHONY: start stop restart up-server stop-server up-server-docker up-web ssh logs ios-gen ios-test ios-build ios-lan-config ios-e2e ios-install

LAN_IP ?= $(shell ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo 127.0.0.1)
LAN_PORT ?= 3012
SERVER_PID_FILE := /tmp/deuces-server.pid

# Start all services
start: | up-web up-server

# Write ios/DeucesCore/LanHost.swift from this Mac's Wi‑Fi IP.
ios-lan-config:
	@mkdir -p ios/DeucesCore
	@printf '%s\n' \
		'import Foundation' \
		'' \
		'/// LAN host for device testing. Regenerated by `make ios-lan-config`.' \
		'public enum LanHost {' \
		'    public static let address = "$(LAN_IP)"' \
		'    public static let port = $(LAN_PORT)' \
		'}' \
		> ios/DeucesCore/LanHost.swift
	@echo "iOS clients → http://$(LAN_IP):$(LAN_PORT)"

# Generate / test / build the iMessage app
ios-gen: ios-lan-config
	@cd ios && xcodegen generate

# In-memory protocol tests + live LAN Socket.IO e2e (requires `make up-server`)
ios-test: ios-gen
	@cd ios && xcodebuild test \
		-project Deuces.xcodeproj \
		-scheme DeucesCore \
		-destination 'platform=iOS Simulator,name=iPhone 17 Pro' \
		CODE_SIGNING_ALLOWED=NO

# Ensure server is up, point clients at LAN, run full e2e suite
ios-e2e: up-server ios-test
	@echo "E2E OK — clients configured for http://$(LAN_IP):$(LAN_PORT)"

ios-build: ios-gen
	@cd ios && xcodebuild build \
		-project Deuces.xcodeproj \
		-scheme Deuces \
		-destination 'generic/platform=iOS' \
		-configuration Debug

# Build + install on connected iPhone/iPad (USB ios-deploy + connected coredevice)
ios-install: ios-build
	@APP=$$(ls -d $$HOME/Library/Developer/Xcode/DerivedData/Deuces-*/Build/Products/Debug-iphoneos/Deuces.app | head -1); \
	echo "Installing $$APP"; \
	ios-deploy --bundle "$$APP" --no-wifi 2>/dev/null || true; \
	xcrun devicectl list devices 2>/dev/null | awk '$$3 ~ /^[0-9A-Fa-f-]{36}$$/ && $$4 == "connected" { print $$3 }' | while read -r id; do \
		echo "devicectl → $$id"; \
		xcrun devicectl device install app --device "$$id" "$$APP" || true; \
	done

# Kill all services
stop:
	@-docker-compose kill 2>/dev/null || true
	@if [ -f $(SERVER_PID_FILE) ]; then kill `cat $(SERVER_PID_FILE)` 2>/dev/null || true; rm -f $(SERVER_PID_FILE); fi
	@pkill -f 'node server.js' 2>/dev/null || true

# Restart all services
restart: | stop start

# Run the Node server on this Mac, bound to 0.0.0.0 so LAN devices can connect.
# Detach into a new session so the process survives the Make/agent shell exiting.
up-server:
	@cd server && npm install --silent
	@if [ -f $(SERVER_PID_FILE) ] && kill -0 `cat $(SERVER_PID_FILE)` 2>/dev/null \
		&& lsof -nP -iTCP:$(LAN_PORT) -sTCP:LISTEN >/dev/null 2>&1; then \
		echo "Server already running (pid $$(cat $(SERVER_PID_FILE)))"; \
	else \
		pkill -f 'node server.js' 2>/dev/null || true; \
		rm -f $(SERVER_PID_FILE); \
		python3 -c "import os,subprocess,time,pathlib,signal; \
log=open('/tmp/deuces-server.log','a'); \
p=subprocess.Popen(['node','server.js'], cwd='server', stdout=log, stderr=log, start_new_session=True); \
pathlib.Path('$(SERVER_PID_FILE)').write_text(str(p.pid)); \
time.sleep(0.8); \
assert p.poll() is None, 'server exited immediately'"; \
	fi
	@echo "Server LAN URL: http://$(LAN_IP):$(LAN_PORT)/create_game"
	@curl -sf -X POST "http://$(LAN_IP):$(LAN_PORT)/create_game" \
		-H 'Content-Type: application/json' \
		-d '{"numPlayers":1}' \
		&& echo "" && echo "LAN create_game OK" \
		|| (echo "LAN create_game FAILED"; tail -20 /tmp/deuces-server.log; exit 1)

stop-server:
	@if [ -f $(SERVER_PID_FILE) ]; then \
		kill `cat $(SERVER_PID_FILE)` 2>/dev/null || true; \
		rm -f $(SERVER_PID_FILE); \
		echo "Stopped LAN server"; \
	fi
	@-pkill -f 'node server.js' 2>/dev/null || true

# Optional: old Docker path (Node 8 image is fragile; prefer `make up-server`)
up-server-docker:
	@docker-compose up -d --build server

# Start the web container
up-web:
	@docker-compose up -d web

# Clears the build cache and rebuilds the container
build-server-fresh:
	@docker-compose build --no-cache server

# Clears the build cache and rebuilds the container
build-web-fresh:
	@docker-compose build --no-cache web

# SSH into a container
# EXAMPLE: make ssh tar=web
ssh:
	@docker exec -it deuces-$${tar} /bin/bash

# Live log viewer
# EXAMPLE: make logs tar=server
#		   make logs tar=web tail=10
tail = -1 # Default to showing all lines
logs:
	@docker logs -f deuces-$${tar} --tail ${tail}

# Same as "logs" but with timestamps
logst:
	@docker logs -t -f deuces-$${tar} --tail ${tail}
